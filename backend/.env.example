# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3001

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=dms

# --- Auth ---
# JWT_SECRET must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# mock | icit   (Q3/Q17 — mock until ICIT API access exists)
AUTH_PROVIDER=mock

# --- ICIT SSO (only needed when AUTH_PROVIDER=icit) ---
ICIT_AUTHENTICATION=
ICIT_INFORMATION=
ICIT_TOKEN=

# --- Local admin fallback ---
# Gated to non-production by Q17. Leave blank to disable entirely.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Uploads (Q21: relative paths, served behind an authorization check) ---
UPLOAD_ROOT=./uploads

# --- Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
