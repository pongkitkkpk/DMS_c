# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3001

# Browser origins allowed to call the API, comma-separated. `localhost` and
# `127.0.0.1` are the SAME server to you and DIFFERENT origins to a browser, so
# list both in development. Never use `*` — it would let any site call this API
# with a signed-in user's token. Production must set this explicitly.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Buddhist-era academic year that "now" belongs to. Memberships (and therefore
# roles) are scoped to it, so this must match the year the fixtures seed — 2567.
# Leave blank to derive it from the date (new year starts in June, unconfirmed).
ACADEMIC_YEAR=2567

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=dms

# --- Auth ---
# JWT_SECRET must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# mock | icit   (Q3/Q17 — mock until ICIT API access exists)
AUTH_PROVIDER=mock

# --- ICIT SSO (only needed when AUTH_PROVIDER=icit) ---
ICIT_AUTHENTICATION=
ICIT_INFORMATION=
ICIT_TOKEN=

# --- Local admin fallback ---
# Gated to non-production by Q17. Leave blank to disable entirely.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Uploads (Q21: relative paths, served behind an authorization check) ---
UPLOAD_ROOT=./uploads
# Per-file cap, enforced while the socket is read (default 10 MB).
UPLOAD_MAX_BYTES=10485760

# --- Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
