# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3001

# How many reverse proxies sit in front of this API. Leave blank when the API
# is reached directly — trusting `X-Forwarded-For` with no proxy in front lets
# any caller claim any address, which defeats the login throttle below. Behind
# one nginx, set 1 (the number of hops you control, never `true`).
TRUST_PROXY=

# Browser origins allowed to call the API, comma-separated. `localhost` and
# `127.0.0.1` are the SAME server to you and DIFFERENT origins to a browser, so
# list both in development. Never use `*` — it would let any site call this API
# with a signed-in user's token. Production must set this explicitly.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Academic year — normally leave this commented out.
#
# The year now lives in the database (`academic_year_setting`, migration 003)
# and an Admin moves it from the dashboard, which lets the move be refused if
# the target year has no Admin of its own. Setting it here overrides that and
# makes the screen read-only; it exists for rehearsals and break-glass, eg:
#
#   ACADEMIC_YEAR=2568 npm start
#
# ACADEMIC_YEAR=2567

# --- Database ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=dms

# --- Auth ---
# JWT_SECRET must be a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h

# mock | icit   (Q3/Q17 — mock until ICIT API access exists)
AUTH_PROVIDER=mock

# One shared password for the mock's fixture accounts. Blank means the mock
# accepts any non-empty password, which is what a laptop wants and what a host
# with a public address must not do: `fixture.admin` is a username published in
# `src/auth/providers/mock.js`, so blank + public URL = an open Admin session.
# Required (8+ characters) whenever the demo runs with NODE_ENV=production.
MOCK_PASSWORD=

# Only for the demonstration deployment. Says "yes, I know this build
# authenticates against fixtures, and I have set MOCK_PASSWORD". Without it a
# production start on the mock provider is refused.
# ALLOW_MOCK_AUTH=1

# --- Login throttling ---
# Sliding window over `login_attempt`. The per-username budget stops one
# password being guessed; the per-address budget stops spraying — one try each
# against many usernames, which trips no per-username counter. The address
# budget is the larger of the two because a campus NAT can put a whole building
# behind one address. Both refusals expire on their own; nothing is ever locked.
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_PER_USERNAME=8
LOGIN_MAX_PER_ADDRESS=60

# --- ICIT SSO (only needed when AUTH_PROVIDER=icit) ---
ICIT_AUTHENTICATION=
ICIT_INFORMATION=
ICIT_TOKEN=

# --- Local admin fallback ---
# Gated to non-production by Q17. Leave blank to disable entirely.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Uploads (Q21: relative paths, served behind an authorization check) ---
UPLOAD_ROOT=./uploads
# Per-file cap, enforced while the socket is read (default 10 MB).
UPLOAD_MAX_BYTES=10485760

# --- Mail ---
# Nothing here. The system sends no email — `check:phase6` asserts that no
# source file imports a mailer, so notification is absent rather than
# half-present, and the `nodemailer` dependency was removed for the same reason.
# These keys used to sit here empty and invited real SMTP credentials into a
# file that nothing would ever read. If email is ever built, they come back
# alongside the code that uses them.

# --- Production only ---
# Set when the deployment genuinely serves the app over plain http on an
# isolated network. Without it, a production start with an `http://` origin in
# CORS_ORIGIN is refused, because a bearer token on plain http is readable by
# anything on the path.
# ALLOW_INSECURE_ORIGINS=1
